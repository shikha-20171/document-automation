}

// =====================================================
// ORGANISATION INTEGRATIONS, API KEYS & WEBHOOKS
// =====================================================

enum IntegrationProvider {
  GOOGLE_WORKSPACE
  GOOGLE_DRIVE
  GOOGLE_DOCS
  MICROSOFT_365
  MICROSOFT_ONEDRIVE
  MICROSOFT_TEAMS
  AWS_S3
  SLACK
  SMTP_EMAIL
  WHATSAPP_BUSINESS
  SALESFORCE
  HUBSPOT
  ZOHO_CRM
  DOCUSIGN
  MICROSOFT_ENTRA_ID
  CUSTOM_REST
  WEBHOOK
}

enum IntegrationCategory {
  STORAGE
  COMMUNICATION
  CRM
  PRODUCTIVITY
  E_SIGNATURE
  AUTHENTICATION
  DEVELOPER
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  FAILED
  CONFIG_REQUIRED
  NOT_CONFIGURED
}

model OrganisationIntegration {
  id                    String              @id @default(uuid())
  organisationId        Int
  provider              IntegrationProvider
  category              IntegrationCategory
  status                IntegrationStatus   @default(DISCONNECTED)
  accountName           String?
  accountEmail          String?
  accessTokenEncrypted  String?             @db.Text
  refreshTokenEncrypted String?             @db.Text
  expiresAt             DateTime?
  metadata              Json?
  connectedById         Int?
  connectedAt           DateTime?
  updatedAt             DateTime            @updatedAt
  lastSyncedAt          DateTime?

  organisation          Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  connectedBy           User?               @relation("IntegrationConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)
  logs                  IntegrationLog[]

  @@unique([organisationId, provider])
  @@index([organisationId])
  @@index([organisationId, status])
  @@map("organisation_integrations")
}

model IntegrationLog {
  id              String       @id @default(uuid())
  organisationId  Int
  integrationId   String?
  provider        String
  action          String
  status          String       @default("SUCCESS") // SUCCESS, FAILED, RUNNING
  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?      @db.Text
  executionTimeMs Int          @default(0)
  externalId      String?
  createdAt       DateTime     @default(now())

  organisation    Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  integration     OrganisationIntegration?  @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([organisationId, provider])
  @@index([organisationId, createdAt])
  @@map("integration_logs")
}

model CustomRestIntegration {
  id             String       @id @default(uuid())
