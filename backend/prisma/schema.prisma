  createdBy      User?        @relation("ApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@map("organisation_api_keys")
}

model OrganisationWebhook {
  id             String            @id @default(uuid())
  organisationId Int
  name           String
  url            String 
  secretHash     String 
  events         String[]
  status         String            @default("ACTIVE")
  createdById    Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy      User?             @relation("WebhookCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries     WebhookDelivery[]

  @@index([organisationId])
  @@map("organisation_webhooks")
}

model WebhookDelivery {
  id             String              @id @default(uuid())
  organisationId Int
  webhookId      String
  event          String
  status         String              @default("PENDING") // SUCCESS, FAILED, PENDING, RETRYING
  payload        Json
  signature      String?
  responseStatus Int?
  responseBody   String?             @db.Text
  attempts       Int                 @default(1)
  errorMessage   String?             @db.Text
  createdAt      DateTime            @default(now())
  deliveredAt    DateTime?

  organisation   Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  webhook        OrganisationWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([webhookId])
  @@index([organisationId, createdAt])
  @@map("webhook_deliveries")
}

model PlatformIntegration {
  id                    String              @id @default(uuid())
  provider              IntegrationProvider @unique
  name                  String
  isEnabled             Boolean             @default(true)
  clientIdEncrypted     String?             @db.Text
  clientSecretEncrypted String?             @db.Text
  redirectUri           String?
  tenantId              String?
  allowedScopes         String[]
  settings              Json?               // AWS S3 bucket config, SMTP default config, WhatsApp platform config
  status                String              @default("ACTIVE") // ACTIVE, NOT_CONFIGURED, DISABLED
  healthStatus          String              @default("HEALTHY") // HEALTHY, DEGRADED, DOWN
  errorRate             Float               @default(0.0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("platform_integrations")
}

