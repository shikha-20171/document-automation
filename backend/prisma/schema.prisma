model AuditLog {
  id               String          @id @default(uuid())
  eventId          String          @unique @db.VarChar(50)
  actorId          String?
  actorUserId      String?
  actorName        String          @db.VarChar(150)
  actorRole        String?         @db.VarChar(50)
  actorType        AuditActorType? @default(SUPER_ADMIN)
  organisationId   String?
  organisationName String?         @db.VarChar(150)
