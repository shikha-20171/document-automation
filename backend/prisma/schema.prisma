// Prisma schema file for Enterprise AI Document Automation SaaS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organisation {
  id          Int      @id @default(autoincrement())
  name        String
  branch      String?  @default("Headquarters")
  email       String
  phone       String?
  website     String?
  address     String?
  city        String?
  state       String?
  country     String?
  postal_code String?
  status      String   @default("active")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  locations     OrganisationLocation[]
  users         User[]
  departments   Department[]
  teams         Team[]
  documents     Document[]
  activity_logs ActivityLog[]
  aiModelAssignments OrganizationAIModelAssignment[]
  invitations   OrganisationInvitation[]
  workflows     Workflow[]
  approvalRequests ApprovalRequest[]
  approvalRules ApprovalRule[]
  templates     DocumentTemplate[]
  integrations  OrganisationIntegration[]
  apiKeys       OrganisationApiKey[]
  webhooks      OrganisationWebhook[]
  integrationLogs IntegrationLog[]
  webhookDeliveries WebhookDelivery[]
  customRestIntegrations CustomRestIntegration[]
  departmentAiRuns           DepartmentAiToolRun[]
  departmentAiTemplates      DepartmentAiTemplate[]
  departmentAiExtractedItems DepartmentAiExtractedRecord[]
  tasks                      Task[]
  notifications              Notification[]

  @@index([name])
  @@index([branch])
  @@index([status])
  @@map("organisations")
}

model OrganisationLocation {
  id              Int          @id @default(autoincrement())
  organisation_id Int
  name            String?
  city            String
  state           String?
  country         String?
  postal_code     String?
  status          String       @default("active")
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organisation    Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  users           User[]

  @@unique([organisation_id, city])
  @@index([organisation_id])
  @@index([city])
  @@map("organisation_locations")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  users       User[]

  @@map("roles")
}

model User {
  id                   Int                   @id @default(autoincrement())
  organisation_id      Int?
  location_id          Int?
  role_id              Int?
  department_id        Int?
  team_id              Int?
  full_name            String
  email                String                @unique
  password_hash        String?
  role                 String                @default("ORGANISATION_ADMIN")
  status               String                @default("active")
  must_change_password Boolean               @default(false)
  reset_token          String?
  reset_token_expires  DateTime?
  custom_permissions   Json?
  last_login           DateTime?
  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt

  organisation         Organisation?         @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  location             OrganisationLocation? @relation(fields: [location_id], references: [id], onDelete: SetNull)
  userRole             Role?                 @relation(fields: [role_id], references: [id], onDelete: SetNull)
  sessions             UserSession[]
  reset_tokens         PasswordResetToken[]
  createdWorkflows     Workflow[]
  workflowSteps        WorkflowStep[]
  requestedApprovals   ApprovalRequest[]
  approvalActions      ApprovalAction[]
  approvalHistoryItems ApprovalHistoryItem[]
  createdApprovalRules ApprovalRule[]
  createdTemplates     DocumentTemplate[]        @relation("TemplateCreatedBy")
  updatedTemplates     DocumentTemplate[]        @relation("TemplateUpdatedBy")
  createdTemplateVersions DocumentTemplateVersion[] @relation("TemplateVersionCreatedBy")
  connectedIntegrations   OrganisationIntegration[] @relation("IntegrationConnectedBy")
  createdApiKeys          OrganisationApiKey[]      @relation("ApiKeyCreatedBy")
  createdWebhooks         OrganisationWebhook[]     @relation("WebhookCreatedBy")
  failed_attempts      Int                   @default(0)
  locked_until         DateTime?
  last_password_change DateTime?
  ownedDepartments     Department[]          @relation("DepartmentOwner")
  departmentAiRuns           DepartmentAiToolRun[]
  departmentAiTemplates      DepartmentAiTemplate[]
  departmentAiExtractedItems DepartmentAiExtractedRecord[]

  @@index([organisation_id])
  @@index([department_id])
  @@index([team_id])
  @@index([location_id])
  @@index([email])
  @@index([role])
  @@map("users")
}

model OrganisationInvitation {
  id              Int          @id @default(autoincrement())
  organisation_id Int
  email           String
  token_hash      String       @unique
  expires_at      DateTime
  accepted_at     DateTime?
  status          String       @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organisation    Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)

  @@index([organisation_id])
  @@index([email])
  @@index([token_hash])
  @@map("organisation_invitations")
}

model UserSession {
  id            Int      @id @default(autoincrement())
  user_id       Int
  refresh_token String   @unique
  expires_at    DateTime
  created_at    DateTime @default(now())

  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model PasswordResetToken {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @unique
  is_used    Boolean  @default(false)
  expires_at DateTime
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Department {
  id              Int          @id @default(autoincrement())
  organisation_id Int
  name            String
  description     String?
  head            String?
  owner_user_id   Int?
  employees_count Int          @default(0)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organisation    Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  owner           User?        @relation("DepartmentOwner", fields: [owner_user_id], references: [id], onDelete: SetNull)

  @@index([organisation_id])
  @@index([owner_user_id])
  @@map("departments")
}

model Team {
  id              Int          @id @default(autoincrement())
  organisation_id Int
  name            String
  department      String?
  team_lead       String?
  members         Int          @default(0)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organisation    Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)

  @@map("teams")
}

model Document {
  id                  Int          @id @default(autoincrement())
  organisation_id     Int
  department_id       Int?
  team_id             Int?
  created_by_user_id  Int?
  name                String
  original_name       String?
  type                String?
  mime_type           String?
  size                Float        @default(0)
  file_size_bytes     BigInt?      @default(0)
  storage_provider    String?      @default("aws_s3")
  s3_bucket           String?
  s3_key              String?
  folder              String?
  folder_id           String?
  status              String       @default("ACTIVE")
  uploaded_by         String?
  uploaded_at         DateTime     @default(now())
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  organisation        Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  approvalRequests    ApprovalRequest[]

  @@index([organisation_id])
  @@index([department_id])
  @@index([team_id])
  @@index([s3_key])
  @@map("documents")
}

model ActivityLog {
  id              Int          @id @default(autoincrement())
  organisation_id Int
  action          String
  user            String
  timestamp       DateTime     @default(now())
  ip_address      String?
  details         String?
  created_at      DateTime     @default(now())

  organisation    Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model Task {
  id               String        @id @default(uuid())
  organisation_id  Int
  department_id    Int?
  team_id          Int?
  created_by_id    Int?
  title            String
  description      String?
  assigned_to      String?
  assigned_to_id   String?
  assigned_email   String?
  related_doc_id   String?
  related_doc_name String?
  priority         String        @default("NORMAL")
  status           String        @default("PENDING")
  start_date       String?
  due_date         String?
  instructions     String?
  team             String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  organisation     Organisation  @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  comments         TaskComment[]

  @@index([organisation_id])
  @@index([department_id])
  @@index([team_id])
  @@map("tasks")
}

model TaskComment {
  id             String   @id @default(uuid())
  taskId         String
  organisationId Int
  userId         Int?
  authorName     String   @default("User")
  content        String   @db.Text
  createdAt      DateTime @default(now())

  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([organisationId])
  @@map("task_comments")
}

model SecurityPolicy {
  id                         String   @id @default(uuid())
  organisationId             Int      @unique
  mfaEnforced                Boolean  @default(false)
  passwordMinLength          Int      @default(8)
  passwordRequireComplexity  Boolean  @default(true)
  lockoutDurationMinutes     Int      @default(15)
  sessionTimeoutMinutes      Int      @default(60)
  ipAllowlist                String[] @default([])
  maxLoginAttempts           Int      @default(5)
  sensitiveDocAiRestricted   Boolean  @default(false)
  externalAiRestricted       Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([organisationId])
  @@map("security_policies")
}

model AiUsagePolicy {
  id                   String   @id @default(uuid())
  organisationId       Int
  departmentId         Int?
  monthlyQuotaRequests Int      @default(10000)
  allowedProviders     String[] @default(["GEMINI", "OPENAI", "CLAUDE"])
  allowedTools         String[] @default(["DOCUMENT_GENERATION", "OCR", "QA", "SUMMARIZATION"])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([organisationId])
  @@index([organisationId, departmentId])
  @@map("ai_usage_policies")
}

model Notification {
  id               String       @id @default(uuid())
  organisation_id  Int
  user_id          Int?
  title            String
  message          String?
  description      String?
  type             String       @default("INFO")
  category         String?
  unread           Boolean      @default(true)
  read             Boolean      @default(false)
  link             String?
  priority         String       @default("NORMAL")
  related_document String?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  organisation     Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)

  @@index([organisation_id])
  @@map("notifications")
}

model DepartmentAiToolRun {
  id              String       @id @default(uuid())
  organisation_id Int?
  user_id         Int?
  department_name String?
  tool            String
  title           String?
  input           Json
  output          Json
  status          String       @default("COMPLETED")
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organisation    Organisation? @relation(fields: [organisation_id], references: [id], onDelete: SetNull)
  user            User?         @relation(fields: [user_id], references: [id], onDelete: SetNull)
  extractedRecords DepartmentAiExtractedRecord[]

  @@index([organisation_id])
  @@index([user_id])
  @@index([tool])
  @@index([created_at])
  @@map("department_ai_tool_runs")
}

model DepartmentAiTemplate {
  id              String       @id @default(uuid())
  organisation_id Int?
  user_id         Int?
  name            String
  template_body   String
  fields          Json
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organisation    Organisation? @relation(fields: [organisation_id], references: [id], onDelete: SetNull)
  user            User?         @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([organisation_id])
  @@index([user_id])
  @@index([updated_at])
  @@map("department_ai_templates")
}

model DepartmentAiExtractedRecord {
  id              String       @id @default(uuid())
  run_id          String?
  organisation_id Int?
  user_id         Int?
  document_name   String?
  record_type     String?
  data            Json
  saved_to        String?      @default("DOCUMENT")
  created_at      DateTime     @default(now())

  run             DepartmentAiToolRun? @relation(fields: [run_id], references: [id], onDelete: SetNull)
  organisation    Organisation?        @relation(fields: [organisation_id], references: [id], onDelete: SetNull)
  user            User?                @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([run_id])
  @@index([organisation_id])
  @@index([user_id])
  @@map("department_ai_extracted_records")
}

// =====================================================
// ENUMS FOR WORKFLOWS & APPROVALS
// =====================================================

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum WorkflowTrigger {
  DOCUMENT_CREATED
  DOCUMENT_SUBMITTED
  DOCUMENT_UPDATED
  DOCUMENT_UPLOADED
}

enum ApprovalType {
  INTERNAL
  EXTERNAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  OVERDUE
}

enum LogicType {
  SEQUENTIAL
  PARALLEL
}

enum LogicRequirement {
  ALL_REQUIRED
  ANY_ONE
}

// =====================================================
// WORKFLOWS
// =====================================================

model Workflow {
  id                    String           @id @default(uuid())
  organisationId        Int
  name                  String
  description           String?
  appliesTo             String
  department            String?
  trigger               WorkflowTrigger  @default(DOCUMENT_SUBMITTED)
  logicType             LogicType        @default(SEQUENTIAL)
  logicRequirement      LogicRequirement @default(ALL_REQUIRED)
  status                WorkflowStatus   @default(DRAFT)
  approvalDeadlineDays  Int              @default(3)
  reminderAfterHours    Int              @default(24)
  escalationAfterHours  Int              @default(48)
  commentsRequiredOnRejection Boolean     @default(false)
  allowRequestChanges   Boolean          @default(true)
  lastRunAt             DateTime?
  createdById           Int
  createdBy             User             @relation(fields: [createdById], references: [id])
  organisation          Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  steps                 WorkflowStep[]
  approvalRequests      ApprovalRequest[]

  @@index([organisationId])
  @@index([organisationId, status])
  @@map("workflows")
}

model WorkflowStep {
  id                      String      @id @default(uuid())
  workflowId              String
  stepOrder               Int
  name                    String
  approverType            String      @db.VarChar(50)
  approvalType            ApprovalType @default(INTERNAL)
  externalApproverName    String?
  externalApproverEmail   String?
  externalApproverCompany String?
  createdById             Int
  createdBy               User        @relation(fields: [createdById], references: [id])
  workflow                Workflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("workflow_steps")
}

// =====================================================
// APPROVAL REQUESTS
// =====================================================

model ApprovalRequest {
  id                String           @id @default(uuid())
  organisationId    Int
  workflowId        String
  documentId        Int?
  documentName      String
  requestedById     Int
  currentStepOrder  Int?             @default(0)
  status            ApprovalStatus   @default(PENDING)
  dueAt             DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organisation      Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  workflow          Workflow         @relation(fields: [workflowId], references: [id])
  requestedBy       User             @relation(fields: [requestedById], references: [id])
  document          Document?        @relation(fields: [documentId], references: [id])
  actions           ApprovalAction[]
  history           ApprovalHistoryItem[]

  @@index([organisationId])
  @@index([workflowId])
  @@index([documentId])
  @@index([status])
  @@map("approval_requests")
}

model ApprovalAction {
  id                String         @id @default(uuid())
  approvalRequestId String
  stepOrder         Int?
  performedById     Int?
  action            String         @db.VarChar(50)
  comment           String?
  createdAt         DateTime       @default(now())

  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  performedBy       User?           @relation(fields: [performedById], references: [id])

  @@index([approvalRequestId])
  @@map("approval_actions")
}

model ApprovalHistoryItem {
  id                String         @id @default(uuid())
  approvalRequestId String
  workflowStepId    String?
  userId            Int?
  userRole          String?
  action            String         @db.VarChar(50)
  comment           String?
  createdAt         DateTime       @default(now())

  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  user              User?           @relation(fields: [userId], references: [id])

  @@index([approvalRequestId])
  @@map("approval_history")
}

// =====================================================
// APPROVAL RULES
// =====================================================

model ApprovalRule {
  id             String   @id @default(uuid())
  organisationId Int
  workflowId     String?
  name           String
  conditionJson  String   @db.Text
  approversJson  String   @db.Text
  status         String   @default("ACTIVE")
  createdById    Int
  createdBy      User     @relation(fields: [createdById], references: [id])
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([organisationId, status])
  @@map("approval_rules")
}

// ENUMS FOR AI MANAGEMENT
// =========================

enum AIProviderStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum AIConnectionStatus {
  CONNECTED
  DISCONNECTED
  FAILED
  TESTING
}

enum AIModelStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
}

// =========================
// AI PROVIDERS
// =========================

model AIProvider {
  id                 String             @id @default(uuid())
  providerName       String             @db.VarChar(100)
  providerCode       String             @unique @db.VarChar(50)
  description        String?            @db.Text
  baseUrl            String?            @db.Text
  apiVersion         String?            @db.VarChar(50)
  apiKeyEncrypted    String?            @db.Text
  region             String?            @db.VarChar(100)
  status             AIProviderStatus   @default(ACTIVE)
  connectionStatus   AIConnectionStatus @default(DISCONNECTED)
  priority           Int                @default(1)
  isDefault          Boolean            @default(false)
  supportsChat       Boolean            @default(true)
  supportsVision     Boolean            @default(false)
  supportsOCR        Boolean            @default(false)
  supportsStreaming  Boolean            @default(true)
  requestTimeoutMs   Int                @default(60000)
  maxRetries         Int                @default(3)
  healthScore        Float?
  lastConnectedAt    DateTime?
  lastHealthCheckAt  DateTime?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  models             AIModel[]
  jobs               AIJobQueue[]
  logs               AILog[]
  costUsages         AICostUsage[]
  serviceHealth      AIServiceHealth?

  @@index([providerCode])
  @@index([status])
  @@index([connectionStatus])
  @@map("ai_providers")
}

// =========================
// AI MODELS
// =========================

model AIModel {
  id                      String        @id @default(uuid())
  providerId              String
  provider                AIProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelName               String        @db.VarChar(100)
  modelCode               String        @db.VarChar(100)
  modelVersion            String?       @db.VarChar(50)
  description             String?       @db.Text
  contextWindow           Int?
  maxInputTokens          Int?
  maxOutputTokens         Int?
  inputCostPer1K          Decimal?      @db.Decimal(10, 4)
  outputCostPer1K         Decimal?      @db.Decimal(10, 4)
  supportsStreaming       Boolean       @default(true)
  supportsVision          Boolean       @default(false)
  supportsFunctionCalling Boolean       @default(false)
  supportsJSONMode        Boolean       @default(false)
  supportsImageInput      Boolean       @default(false)
  status                  AIModelStatus @default(ACTIVE)
  isDefault               Boolean       @default(false)
  totalRequests           BigInt        @default(0)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  jobs                    AIJobQueue[]
  logs                    AILog[]
  costUsages              AICostUsage[]
  orgAssignments          OrganizationAIModelAssignment[]

  @@unique([providerId, modelCode])
  @@index([providerId])
  @@index([status])
  @@map("ai_models")
}

// =================================================
// ORGANIZATION ↔ AI MODEL ASSIGNMENT
// =================================================

enum OrgModelAssignmentStatus {
  ACTIVE
  INACTIVE
}

model OrganizationAIModelAssignment {
  id             String                   @id @default(uuid())
  organisationId Int
  modelId        String
  status         OrgModelAssignmentStatus @default(ACTIVE)
  assignedBy     String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organisation   Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  model          AIModel                  @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([organisationId, modelId])
  @@index([organisationId])
  @@index([modelId])
  @@map("organization_ai_model_assignments")
}

model AICapability {
  id            String   @id @default(uuid())
  name          String   @db.VarChar(100)
  code          String   @unique @db.VarChar(50)
  description   String?  @db.Text
  defaultModel  String   @default("gemini-3.5-flash") @db.VarChar(100)
  fallbackModel String?  @default("gpt-4o-mini") @db.VarChar(100)
  maxTokens     Int      @default(4096)
  temperature   Float    @default(0.3)
  systemPrompt  String?  @db.Text
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([code])
  @@index([status])
  @@map("ai_capabilities")
}

// ===================================
// ENUMS FOR OCR MANAGEMENT
// ===================================

enum OCRProviderStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum OCRConnectionStatus {
  CONNECTED
  DISCONNECTED
  FAILED
  TESTING
}

enum OCRJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
  CANCELLED
}

enum OCREngineStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum OCRRequestStatus {
  QUEUED
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

// ===================================
// OCR PROVIDERS (Google Document AI, AWS Textract, Azure Document Intelligence)
// ===================================

model OCRProvider {
  id                   String              @id @default(uuid())
  providerName         String              @db.VarChar(100)
  providerCode         String              @unique @db.VarChar(50)
  description          String?             @db.Text
  apiEndpoint          String?             @db.Text
  credentialsEncrypted String?             @db.Text
  authType             String              @default("API_KEY") @db.VarChar(50) // API_KEY, SERVICE_ACCOUNT, AWS_IAM, AZURE_SECRET
  region               String?             @default("global") @db.VarChar(100)
  status               OCRProviderStatus   @default(ACTIVE)
  connectionStatus     OCRConnectionStatus @default(CONNECTED)
  priority             Int                 @default(1)
  isEnabled            Boolean             @default(true)
  isDefault            Boolean             @default(false)
  supportedFormats     String[]            @default(["PDF", "PNG", "JPG", "TIFF", "WEBP"])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  profiles             OCRProfile[]
  jobs                 OCRJob[]
  logs                 OCRLog[]
  costUsages           OCRCostUsage[]
  serviceHealth        OCRServiceHealth?

  @@index([providerCode])
  @@index([status])
  @@index([connectionStatus])
  @@map("ocr_providers")
}

// ===================================
// OCR PROFILES
// ===================================

model OCRProfile {
  id                   String        @id @default(uuid())
  profileName          String        @db.VarChar(100)
  profileCode          String        @unique @db.VarChar(50)
  description          String?       @db.Text
  providerId           String?
  provider             OCRProvider?  @relation(fields: [providerId], references: [id], onDelete: SetNull)
  language             String        @default("eng") @db.VarChar(50)
  inputFormats         String[]      @default(["PDF", "PNG", "JPG", "TIFF"])
  textDetection        Boolean       @default(true)
  tableDetection       Boolean       @default(true)
  layoutDetection      Boolean       @default(true)
  handwritingDetection Boolean       @default(false)
  confidenceThreshold  Float         @default(80.0)
  outputFormat         String        @default("STRUCTURED_JSON") @db.VarChar(50) // PLAIN_TEXT, STRUCTURED_JSON, LAYOUT_DATA, TABLES
  status               String        @default("ACTIVE") // ACTIVE, INACTIVE
  isDefault            Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  jobs                 OCRJob[]
  logs                 OCRLog[]
  costUsages           OCRCostUsage[]

