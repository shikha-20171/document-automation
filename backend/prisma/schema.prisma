  currentValue    Json?
  requestedValue  Json?
  severity        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status          String    @default("PENDING_APPROVAL") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, APPLIED
  approverId      Int?
  approverName    String?
  approvalReason  String?   @db.Text
  reviewedAt      DateTime?
  appliedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organisationId])
  @@index([status])
  @@index([changeType])
  @@map("governance_change_requests")
}

model AccessReviewCampaign {
  id             String             @id @default(uuid())
  name           String
  description    String?            @db.Text
  organisationId Int
  reviewerId     Int?
  reviewerName   String?
  startDate      DateTime           @default(now())
  dueDate        DateTime
  status         String             @default("ACTIVE") // ACTIVE, IN_PROGRESS, COMPLETED, EXPIRED
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  items          AccessReviewItem[]

  @@index([organisationId])
  @@index([status])
  @@map("access_review_campaigns")
}

model AccessReviewItem {
  id                  String               @id @default(uuid())
  campaignId          String
  userId              Int
  userName            String
  userEmail           String
  currentRole         String
  currentDepartmentId Int?
  currentDepartment   String?
  lastLogin           DateTime?
  status              String               @default("PENDING") // PENDING, CERTIFIED, REVOKED, CHANGE_REQUESTED
  decisionReason      String?              @db.Text
  decidedById         Int?
  decidedByName       String?
  decidedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  campaign            AccessReviewCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@map("access_review_items")
}

model Incident {
  id                 String            @id @default(uuid())
  incidentNumber     String            @unique
  organisationId     Int
  title              String
  description        String            @db.Text
  category           String            @default("SECURITY") // SECURITY, ACCESS, DATA_LEAK, SYSTEM_OUTAGE, POLICY_VIOLATION, OTHER
  severity           String            @default("MEDIUM")   // LOW, MEDIUM, HIGH, CRITICAL
  status             String            @default("OPEN")     // OPEN, INVESTIGATING, CONTAINED, RESOLVED, CLOSED
  reporterId         Int?
  reporterName       String?
  assigneeId         Int?
  assigneeName       String?
  resolution         String?           @db.Text
  investigationNotes String?           @db.Text
  resolvedAt         DateTime?
  closedAt           DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  history            IncidentHistory[]

  @@index([organisationId])
  @@index([status])
  @@index([severity])
  @@map("governance_incidents")
}

model IncidentHistory {
  id             String    @id @default(uuid())
  incidentId     String
  actorId        Int?
  actorName      String?
  action         String
  previousStatus String?
  newStatus      String?
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())

  incident       Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("governance_incident_history")
}

model Risk {
  id             String        @id @default(uuid())
  riskId         String        @unique
  organisationId Int
  title          String
  description    String        @db.Text
  category       String        @default("SECURITY") // SECURITY, COMPLIANCE, OPERATIONAL, DATA_PRIVACY, AVAILABILITY
  likelihood     String        @default("LOW")      // LOW, MEDIUM, HIGH
  impact         String        @default("MEDIUM")   // LOW, MEDIUM, HIGH, CRITICAL
  riskScore      Int           @default(6)
  severity       String        @default("MEDIUM")   // LOW, MEDIUM, HIGH, CRITICAL
  ownerId        Int?
  ownerName      String?
  status         String        @default("IDENTIFIED") // IDENTIFIED, ASSESSING, MITIGATING, CONTROLLED, ACCEPTED, CLOSED
  mitigationPlan String?       @db.Text
  dueDate        DateTime?
  createdById    Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  history        RiskHistory[]

  @@index([organisationId])
  @@index([status])
  @@index([severity])
  @@map("governance_risks")
}

model RiskHistory {
  id             String    @id @default(uuid())
  riskId         String
  actorId        Int?
  actorName      String?
  action         String
  previousStatus String?
  newStatus      String?
  changes        Json?
  createdAt      DateTime  @default(now())

  risk           Risk      @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@index([riskId])
  @@map("governance_risk_history")
}




