  authType       String       @default("NONE") // NONE, API_KEY, BEARER_TOKEN, BASIC_AUTH, OAUTH2
  authConfig     Json?        // Encrypted headers / key / token
  headers        Json?        // Custom static headers
  timeoutMs      Int          @default(10000)
  retryCount     Int          @default(1)
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("custom_rest_integrations")
}

model OrganisationApiKey {
