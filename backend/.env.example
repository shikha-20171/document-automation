# ==============================================================================
# DOCUCORE AI DOCUMENT AUTOMATION PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server & Networking
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/document_automation?schema=public"

# Redis Cache & Queue
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication & Security
JWT_SECRET=docucore_jwt_secret_dev_32_chars_long_key!
ENCRYPTION_KEY=docucore_secret_key_32_bytes_long_aes_256!!
INTEGRATION_ENCRYPTION_KEY=docucore_secret_key_32_bytes_long_aes_256!!

# AI Gateway & Vision OCR
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 1. Google Drive & Docs Integration (OAuth 2.0)
# Setup: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client
# Scopes: https://www.googleapis.com/auth/drive.file, userinfo.email, userinfo.profile
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5001/api/integrations/google_drive/callback

# ------------------------------------------------------------------------------
# 2. Slack Integration (OAuth 2.0 / Bot Token)
# Setup: api.slack.com -> Your App -> OAuth & Permissions
# Scopes: chat:write, channels:read, groups:read, users:read
# ------------------------------------------------------------------------------
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:5001/api/integrations/slack/callback
SLACK_BOT_TOKEN=xoxb-your_optional_direct_bot_token_here

# ------------------------------------------------------------------------------
# 3. Microsoft Teams & 365 (Microsoft Graph OAuth 2.0)
# Setup: portal.azure.com -> App Registrations
# Scopes: User.Read, ChannelMessage.Send, Files.ReadWrite
# ------------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_REDIRECT_URI=http://localhost:5001/api/integrations/microsoft_teams/callback
MICROSOFT_TENANT_ID=common

# ------------------------------------------------------------------------------
# 4. DocuSign E-Signature Integration
# Setup: developers.docusign.com -> Apps and Keys
# ------------------------------------------------------------------------------
DOCUSIGN_INTEGRATION_KEY=your_docusign_integration_key_here
DOCUSIGN_ACCOUNT_ID=your_docusign_account_id_here

# ------------------------------------------------------------------------------
# 5. Salesforce, HubSpot & Zoho CRM
# ------------------------------------------------------------------------------
SALESFORCE_CLIENT_ID=your_salesforce_client_id_here
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret_here
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token_here
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
